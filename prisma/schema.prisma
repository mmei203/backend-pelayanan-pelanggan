generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model History {
  id             String    @id
  pelangganId    String    @unique
  namaPelanggan  String    @db.VarChar(500)
  keluhan        String    @db.Text
  tanggalLaporan DateTime
  tanggalSelesai DateTime  @default(now())
  createdAt      DateTime  @default(now())
  Pelanggan      Pelanggan @relation(fields: [pelangganId], references: [id], onDelete: Cascade)
}

model Pelanggan {
  id              String                    @id
  namaPelanggan   String                    @db.VarChar(500)
  alamat          String                    @db.Text
  createdAt       DateTime                  @default(now())
  keluhan         String                    @db.Text
  noPdam          String
  noTelp          String
  statusPelanggan Pelanggan_statusPelanggan @default(PENDING)
  updatedAt       DateTime
  finished        DateTime?
  History         History?
}

model TABEL_PELANGGAN {
  ID_PELANGGAN   String    @id @db.VarChar(36)
  NO_KONTAK_PDAM String?   @db.VarChar(50)
  NAMA_PELANGGAN String    @db.VarChar(255)
  NO_HP          String    @db.VarChar(20)
  ALAMAT         String?   @db.Text
  CREATED_AT     DateTime? @db.Timestamp(0)

  @@index([NO_KONTAK_PDAM], map: "AK_IDENTIFIER_NO_KONTAK_PDAM")
}

model TABEL_PENGADUAN {
  ID_PENGADUAN       String                          @id @default(uuid()) @db.VarChar(36)
  ID_PELANGGAN       String                          @db.VarChar(36)
  ID_USER_PENERIMA   String                          @db.VarChar(36)
  ID_USER_PENANGANAN String?                         @db.VarChar(36)
  KELUHAN            String                          @db.Text
  STATUS             String                          @db.VarChar(20)
  LATITUDE           String?                         @db.VarChar(50)
  LONGITUDE          String?                         @db.VarChar(50)
  DOKUMEN_LAPORAN    String?                         @db.VarChar(500)
  FOTO_KELUHAN       String?                         @db.VarChar(255)
  TANGGAL_DITERIMA   DateTime                        @db.DateTime(0)
  TANGGAL_DIPROSES   DateTime?                       @db.DateTime(0)
  TANGGAL_SELESAI    DateTime?                       @db.DateTime(0)
  CREATED_AT         DateTime                        @db.Timestamp(0)
  UPDATED_AT         DateTime?                       @db.Timestamp(0)
  SALURAN_KELUHAN    TABEL_PENGADUAN_SALURAN_KELUHAN
  SUMBER_ADUAN       TABEL_PENGADUAN_SUMBER_ADUAN
}

model TABEL_USER {
  ID_USER    String          @id @db.VarChar(36)
  NAMA_USER  String          @db.VarChar(100)
  EMAIL      String          @db.VarChar(255)
  USERNAME   String          @db.VarChar(255)
  PASSWORD   String          @db.VarChar(255)
  ROLE       TABEL_USER_ROLE
  CREATED_AT DateTime?       @db.Timestamp(0)

  @@index([USERNAME], map: "AK_IDENTIFIER_USERNAME")
  @@index([EMAIL], map: "AK_IDENTIFIRE_EMAIL")
}

enum TABEL_USER_ROLE {
  Super_Admin @map("Super Admin")
  CS
  Operator
  Pengawas
}

enum Pelanggan_statusPelanggan {
  PENDING
  ON_PROGRESS
  SELESAI
}

enum TABEL_PENGADUAN_SALURAN_KELUHAN {
  Datang_Langsung @map("Datang Langsung")
  Via_Telepon     @map("Via Telepon")
  Temuan_Lapangan @map("Temuan Lapangan")
}

enum TABEL_PENGADUAN_SUMBER_ADUAN {
  Pelanggan
  Non_Pelangan @map("Non Pelangan")
}
